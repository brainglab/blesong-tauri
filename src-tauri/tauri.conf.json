{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blesong",
  "version": "2.1.0",
  "identifier": "com.blesong.app",
  "build": {
    "frontendDist": "../blesong-angular/dist/blesong/browser",
    "beforeDevCommand": "npm --prefix blesong-angular exec -- ng serve --port 4200",
    "beforeBuildCommand": "node scripts/prebuild-tauri.mjs",
    "devUrl": "http://localhost:4200"
  },
  "app": {
    "windows": [
      {
        "title": "Blesong",
        "width": 1280,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/data.sqlite",
      "www/browser/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist"
    }
  }
}